{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Quantelune",
  "version": "2.0.18",
  "identifier": "dev.statforge.desktop",
  "build": {
    "beforeDevCommand": "cd ../web && pnpm dev --port 3000",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "cd ../web && pnpm build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Quantelune · 2.0.18",
        "label": "main",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; media-src 'self' blob: http://127.0.0.1:*; frame-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/statforge-sidecar"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "windows/setup-hooks.nsh",
        "compression": "none"
      }
    }
  }
}
