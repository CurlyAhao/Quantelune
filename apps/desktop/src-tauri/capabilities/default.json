{
  "identifier": "default",
  "description": "Default capabilities for StatForge main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-write-file",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message"
  ]
}
